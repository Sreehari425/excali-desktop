{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Permissions for the main Excalidraw window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:1420"]
  },
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:create-app-specific-dirs",
    "fs:allow-applocaldata-read",
    "fs:allow-applocaldata-write"
  ]
}
