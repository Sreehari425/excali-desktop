{
  "$schema": "https://schema.tauri.app/config/3",
  "productName": "Excalidraw Desktop",
  "version": "0.1.0",
  "identifier": "com.local.excalidesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Excalidraw Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": ["deb"],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-4-1",
          "libglib2.0-0",
          "libatk1.0-0",
          "libatk-bridge2.0-0",
          "libatspi2.0-0",
          "libdbus-1-3",
          "libcups2",
          "libx11-6",
          "libxcomposite1",
          "libxdamage1",
          "libxext6",
          "libxfixes3",
          "libxrandr2",
          "libgbm1",
          "libexpat1",
          "libxcb1",
          "libxkbcommon0",
          "libcairo2",
          "libpango-1.0-0",
          "libudev1",
          "libasound2",
          "libgl1",
          "libnspr4",
          "libnss3",
          "xdg-desktop-portal",
          "zenity"
        ]
      }
    },
    "category": "Graphics and Design",
    "shortDescription": "Offline Excalidraw desktop editor"
  }
}
